# EdgeIQ backend configuration (copy to .env; never commit real keys — SRS §08)
EDGEIQ_ENVIRONMENT=development

# Risk controls
EDGEIQ_KELLY_FRACTION=0.25
EDGEIQ_MAX_STAKE_PCT=0.05
EDGEIQ_DAILY_LOSS_LIMIT_PCT=0.10
EDGEIQ_WEEKLY_LOSS_LIMIT_PCT=0.25
EDGEIQ_PARLAY_LEGS=8

# Data stores (match docker-compose.yml)
EDGEIQ_DATABASE_URL=postgresql://edgeiq:edgeiq@localhost:5432/edgeiq
EDGEIQ_TIMESCALE_URL=postgresql://edgeiq:edgeiq@localhost:5433/edgeiq_ts
EDGEIQ_REDIS_URL=redis://localhost:6379/0

# AI agents
EDGEIQ_CLAUDE_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_API_KEY=...
# PERPLEXITY_API_KEY=...
# REDDIT_CLIENT_ID=...
# SPORTRADAR_API_KEY=...
